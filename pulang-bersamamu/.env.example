# This file contains example environment variables
# Copy this to .env.local and fill in your actual values if needed

# Optional: Spotify Web API (for dynamic playlist embed)
# VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
# VITE_SPOTIFY_REDIRECT_URI=http://localhost:3000

# Optional: Google Analytics (if you want to track visitors)
# VITE_GA_ID=your_google_analytics_id

# Site Configuration
VITE_SITE_TITLE=Pulang Bersamamu
VITE_SITE_DESCRIPTION=A place filled with tiny memories
